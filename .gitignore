# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
.env.local
.env*.local
env.txt
*.key

# reference material (not part of the public repo)
_ref/
scratchpad/

# generated preview artefacts
/public/preview/
/public/vendor/
/scripts/.out-*

# render artefacts
/.render/
/.render-tmp/
/.piper-models/
/renders/
/samples/*.json
/.smoke/
# `npm run smoke:pages` stages compositions here so root-relative asset paths
# resolve over file://; it cleans up after itself, but a killed run must not
# leave them to be deployed.
/public/__smoke/
.vercel
.env*
