{
    "name": "scriptorium",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "tsx --test \"src/**/*.test.ts\"",
        "smoke:ai": "tsx --env-file=.env.local scripts/smoke-ai.ts",
        "typecheck": "tsc --noEmit",
        "smoke:voice": "tsx --env-file=.env.local scripts/smoke-voice.ts",
        "preview:build": "tsx scripts/build-preview.ts",
        "audit:languages": "tsx --env-file=.env.local scripts/audit-languages.ts",
        "samples": "tsx --env-file=.env.local scripts/make-samples.ts",
        "render": "tsx --env-file-if-exists=.env.local render/render.ts",
        "render:sandbox": "tsx --env-file-if-exists=.env.local scripts/render-sandbox.ts",
        "prove:gate": "tsx --env-file-if-exists=.env.local scripts/prove-gate.ts",
        "gallery": "tsx --env-file-if-exists=.env.local scripts/build-gallery.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.115.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@vercel/sandbox": "^2.9.0",
        "gsap": "^3.15.0",
        "next": "16.2.12",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "unpdf": "^1.8.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.12",
        "lucide-static": "^1.27.0",
        "playwright-core": "^1.62.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.1",
        "typescript": "^5"
    }
}
